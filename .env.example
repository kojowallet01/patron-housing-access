# Campus Institute environment example
# Copy this file to .env and update the secret values.

# Core campus configuration
CAMPUS_INSTITUTE_NAME=CAMPUS INSTITUTE
DEFAULT_CAMPUS=TESANO CAMPUS

# Global fallback credentials
ADMIN_TOKEN=change-me-admin
SECURITY_TOKEN=change-me-security
SUPER_ADMIN_TOKEN=change-me-super-admin

# Campus-specific credentials
CAMPUS_ADMIN_TOKENS={"TESANO CAMPUS":"tesano-admin","TEMA CAMPUS":"tema-admin","MADINA CAMPUS":"madina-admin","CHRISTIANSBORG CAMPUS":"christiansborg-admin"}
CAMPUS_SECURITY_TOKENS={"TESANO CAMPUS":"tesano-security","TEMA CAMPUS":"tema-security","MADINA CAMPUS":"madina-security","CHRISTIANSBORG CAMPUS":"christiansborg-security"}

# Frontend config
VITE_CAMPUS=TESANO CAMPUS
VITE_ADMIN_TOKEN=change-me-admin
VITE_SECURITY_TOKEN=change-me-security
VITE_SUPER_ADMIN_TOKEN=change-me-super-admin
VITE_CAMPUS_ADMIN_TOKENS={"TESANO CAMPUS":"tesano-admin","TEMA CAMPUS":"tema-admin","MADINA CAMPUS":"madina-admin","CHRISTIANSBORG CAMPUS":"christiansborg-admin"}
VITE_CAMPUS_SECURITY_TOKENS={"TESANO CAMPUS":"tesano-security","TEMA CAMPUS":"tema-security","MADINA CAMPUS":"madina-security","CHRISTIANSBORG CAMPUS":"christiansborg-security"}

# Optional local dev
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
